# ─── Non-secret production defaults ───────────────────────────────────────────
# This file is safe to commit. It must NOT contain secret keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is public and safe to commit.
# CLERK_SECRET_KEY must be set in the Railway Variables tab only.

NODE_ENV=production

# Update after first Railway deploy
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/login

# Google Calendar
GOOGLE_REDIRECT_URI=https://your-app.up.railway.app/api/auth/google/callback
GOOGLE_CALENDAR_ID=primary
