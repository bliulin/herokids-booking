# ─── Non-secret production defaults ───────────────────────────────────────────
# This file is safe to commit. It must NOT contain passwords, tokens, or keys.
# All secrets are set via the Railway dashboard (Variables tab).
#
# Railway injects DATABASE_URL automatically when a Postgres plugin is attached.
# Replace the placeholder URLs below with your actual Railway app domain once
# Railway assigns one (e.g. https://herokids-booking.up.railway.app).

NODE_ENV=production

# Update this to your Railway app URL after first deploy
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-app.up.railway.app/api/auth/google/callback

# Use 'primary' or paste a specific calendar ID from Google Calendar settings
GOOGLE_CALENDAR_ID=primary
